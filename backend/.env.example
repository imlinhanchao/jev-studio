# ========================================================
# JEV 决策中台环境配置示例 (.env.example)
# ========================================================

# 管理员登录账密配置 (中台登录界面使用)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT 会话安全密钥与有效期 (分钟)
JWT_SECRET=jev_platform_jwt_secret_key_liquidai_2026_super_secure_32bytes_min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 默认模型配置: LiquidAI/d1-omni-600M, MiniCPM5-2B-Jev 或 EdgeJev
MODEL_ID=LiquidAI/d1-omni-600M
MODEL_DEVICE=auto
PREFER_LOCAL_SIMULATION=false

# API Key 默认额度与频次限制
DEFAULT_KEY_QUOTA=500000
DEFAULT_RATE_LIMIT_RPM=120
